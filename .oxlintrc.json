{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "unicorn", "import", "promise", "vue", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "style": "off"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": [
    "dist",
    ".histoire",
    "node_modules",
    "react-components",
    "**/*.d.ts"
  ],
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],

    "import/no-unassigned-import": "off",
    "import/no-named-as-default": "off",
    "vitest/require-mock-type-parameters": "off",
    "no-underscore-dangle": "off",

    // 降为 warn 的理由：src/tooltip/Tooltip.tsx:32,42,43 在 computed 里就地改写
    // tooltipState（已确认是真问题）。修法是改成 reactive 或让 computed 返回派生
    // 对象，但 Tooltip 本身在阶段一的 Portal/Popover 重构清单里，届时一并处理。
    "vue/no-side-effects-in-computed-properties": "warn"
  },
  "overrides": [
    {
      "files": ["**/tests/**"],
      "env": { "vitest": true }
    }
  ]
}
