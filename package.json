{
  "name": "today-ui",
  "version": "0.2.0",
  "description": "dropdown menu toolptip powered by vue3, floating-ui",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "*.vue",
    "*.md",
    "dist/*",
    "*.css"
  ],
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "histoire dev",
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "preview": "histoire preview",
    "doc": "histoire build",
    "doc:preview": "histoire preview",
    "test": "vitest --environment jsdom",
    "test:watch": "vitest --environment jsdom --watch",
    "test:coverage": "vitest --environment jsdom --coverage",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --ignore-path .gitignore"
  },
  "devDependencies": {
    "@histoire/plugin-vue": "1.0.0-beta.1",
    "@tsconfig/node24": "~24.0.3",
    "@types/jsdom": "^27.0.0",
    "@types/node": "24.10.1",
    "@types/postcss-import": "^14.0.3",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-vue": "6.0.1",
    "@vitejs/plugin-vue-jsx": "5.0.1",
    "@vue/compiler-core": "^3.5.26",
    "@vue/compiler-sfc": "^3.5.26",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "0.8.1",
    "cross-env": "10.0.0",
    "eslint": "^9.39.2",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-vue": "^10.6.2",
    "histoire": "1.0.0-beta.1",
    "jsdom": "^22.1.0",
    "npm-run-all": "^4.1.5",
    "pinia": "3.0.3",
    "postcss": "^8.5.6",
    "postcss-import": "16.1.1",
    "postcss-nested": "^7.0.2",
    "tsdown": "^0.19.0",
    "typescript": "5.9.2",
    "vite": "7.3.5",
    "vitest": "4.0.15",
    "vue-tsc": "3.2.0"
  },
  "dependencies": {
    "@floating-ui/vue": "^1.1.9",
    "griffel-vue": "^0.4.0",
    "radash": "^12.1.1",
    "vue": "^3.5.26"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "keywords": [
    "vue3",
    "vue",
    "Vue.js",
    "fluent design",
    "fluent",
    "floating-ui",
    "@floating-ui/dom",
    "composition api",
    "tooltip",
    "menu",
    "dropdown",
    "contextmenu",
    "modal",
    "file-tree"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wflixu/Today-UI"
  },
  "author": "wflixu",
  "license": "MIT"
}
